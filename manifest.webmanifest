{
  "name": "FORGE DFS Lab",
  "short_name": "FORGE",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#141110",
  "theme_color": "#141110",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{"name": "dkfile", "accept": ["text/csv", ".csv", "text/comma-separated-values", "application/csv", "application/vnd.ms-excel", "text/plain", "application/octet-stream"]}]
    }
  }
}
